# PhysicsLab Server Environment Variables (Groq Provider)
#
# GROQ_API_KEY: Secret API key for Groq Cloud API (server-only).
# Obtain from https://console.groq.com/keys.
# Keep empty in version control; supply in .env.local for local testing.
GROQ_API_KEY=

# GROQ_MODEL: Target model supporting Structured Outputs via Groq Responses API.
# Initial documented model for development on Groq: openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b
